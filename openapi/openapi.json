{
  "openapi": "3.1.0",
  "info": {
    "title": "ITSM API",
    "version": "0.4.0-d05",
    "description": "D02a foundation + D02 domain read contract + D03 permission foundation + D05 dashboard aggregates. Every operation is authorised server-side, default deny: a workspace the caller cannot see answers 404, a visible workspace without the needed permission answers 403 forbidden. Business permissions come from the role (cs, lead_cs); administration and integration rights come only from explicit workspace grants. Permission endpoints are UI metadata, never a source of access. Domain-rule refusals answer 422 rule_violation with a generic message; optimistic-lock conflicts answer 409 version_conflict. Source of truth for BE/FE; TS types are generated from this file. UAT only: direct Superadmin entry on a marked dummy database. Production and SSO are not available."
  },
  "servers": [{ "url": "/" }],
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-itsm_session",
        "description": "Server-side session. Plain-HTTP local UAT uses the cookie name `itsm_session`."
      },
      "csrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "Required on every unsafe method under /api/v1 except UAT entry."
      }
    },
    "parameters": {
      "WorkspaceId": {
        "name": "workspace_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" },
        "description": "Unknown, malformed or foreign IDs all return 404."
      },
      "TicketId": { "name": "ticket_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" }, "description": "Scoped to workspace_id; a ticket of another workspace returns 404." },
      "AttachmentId": { "name": "attachment_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" }, "description": "Scoped to workspace_id and ticket_id; otherwise 404." },
      "ReportRunId": { "name": "report_run_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" }, "description": "Scoped to workspace_id; otherwise 404." }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string",
                "enum": ["unauthenticated", "forbidden", "csrf_failed", "not_found", "version_conflict", "rule_violation", "invalid_request", "uat_not_available", "dependency_unavailable", "internal"]
              },
              "message": { "type": "string" }
            }
          }
        }
      },
      "Meta": {
        "type": "object",
        "required": ["environment", "accessMode", "banner"],
        "properties": {
          "environment": { "type": "string", "enum": ["uat", "production"] },
          "accessMode": { "type": "string", "enum": ["uat_superadmin", "sso"] },
          "banner": { "type": ["string", "null"], "examples": ["Mode uji — Superadmin"] },
          "uat": { "oneOf": [{ "$ref": "#/components/schemas/UatNotice" }, { "type": "null" }], "description": "Present only in UAT Superadmin mode; null/absent otherwise." }
        }
      },
      "User": {
        "type": "object",
        "required": ["id", "displayName"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "displayName": { "type": "string" }
        }
      },
      "Session": {
        "type": "object",
        "required": ["user", "banner", "uatSuperadmin"],
        "properties": {
          "user": { "$ref": "#/components/schemas/User" },
          "banner": { "type": ["string", "null"] },
          "uatSuperadmin": { "type": "boolean" }
        }
      },
      "SessionIssued": {
        "allOf": [
          { "$ref": "#/components/schemas/Session" },
          {
            "type": "object",
            "required": ["csrfToken"],
            "properties": { "csrfToken": { "type": "string", "description": "Returned once; keep in memory only." } }
          }
        ]
      },
      "Workspace": {
        "type": "object",
        "required": ["id", "code", "name", "timezone", "companyId", "version", "myRole"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "code": { "type": "string", "pattern": "^[A-Z0-9]{2,10}$" },
          "name": { "type": "string" },
          "timezone": { "type": "string" },
          "companyId": { "type": "string", "format": "uuid" },
          "version": { "type": "integer" },
          "myRole": { "type": ["string", "null"], "enum": ["cs", "lead_cs", null] }
        }
      },
      "Member": {
        "type": "object",
        "required": ["userId", "displayName", "role", "active"],
        "properties": {
          "userId": { "type": "string", "format": "uuid" },
          "displayName": { "type": "string" },
          "role": { "type": "string", "enum": ["cs", "lead_cs"] },
          "active": { "type": "boolean" }
        }
      },
      "TicketStatus": {
        "type": "object",
        "description": "Internal code + UI label. `closed` is a read-only historical archive state: never selectable, never mapped to resolved. Close final is not available.",
        "required": ["code", "label", "selectable", "archived"],
        "properties": {
          "code": { "type": "string", "enum": ["new", "open", "pending_customer", "pending_engineering", "resolved", "closed"] },
          "label": { "type": "string", "examples": ["Menunggu pekerjaan eksternal"] },
          "selectable": { "type": "boolean" },
          "archived": { "type": "boolean" }
        }
      },
      "CatalogItem": {
        "type": "object",
        "required": ["id", "code", "label", "active", "sortOrder"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "code": { "type": "string", "description": "Unique per workspace. Priority codes are the existing low/normal/high/urgent." },
          "label": { "type": "string" },
          "active": { "type": "boolean" },
          "sortOrder": { "type": "integer" }
        }
      },
      "Catalogs": {
        "type": "object",
        "required": ["workspaceId", "priorities", "categories", "products", "receivingUnits", "regions", "intakeChannels"],
        "properties": {
          "workspaceId": { "type": "string", "format": "uuid" },
          "priorities": { "type": "array", "items": { "$ref": "#/components/schemas/CatalogItem" } },
          "categories": { "type": "array", "items": { "$ref": "#/components/schemas/CatalogItem" } },
          "products": { "type": "array", "items": { "$ref": "#/components/schemas/CatalogItem" } },
          "receivingUnits": { "type": "array", "items": { "$ref": "#/components/schemas/CatalogItem" } },
          "regions": { "type": "array", "items": { "$ref": "#/components/schemas/CatalogItem" } },
          "intakeChannels": { "type": "array", "items": { "$ref": "#/components/schemas/CatalogItem" } }
        }
      },
      "Ticket": {
        "type": "object",
        "required": ["id", "workspaceId", "number", "displayNumber", "subject", "chronology", "receivedAt", "status", "cycleNo", "intakeChannelId", "priorityId", "categoryId", "productId", "receivingUnitId", "regionId", "merchantId", "ownerUserId", "transactionActivity", "cause", "foreignBranchReference", "version", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid", "description": "Relation/API identifier." },
          "workspaceId": { "type": "string", "format": "uuid" },
          "number": { "type": "integer", "minimum": 1, "description": "Atomic per-workspace counter; unique within the workspace." },
          "displayNumber": { "type": "string", "examples": ["DUMA-1"], "description": "KODEWORKSPACE-number for display only. Not a BI regulator code." },
          "subject": { "type": "string" },
          "chronology": { "type": "string" },
          "receivedAt": { "type": "string", "format": "date-time" },
          "status": { "$ref": "#/components/schemas/TicketStatus" },
          "cycleNo": { "type": "integer", "minimum": 1 },
          "intakeChannelId": { "type": ["string", "null"], "format": "uuid" },
          "priorityId": { "type": ["string", "null"], "format": "uuid" },
          "categoryId": { "type": ["string", "null"], "format": "uuid" },
          "productId": { "type": ["string", "null"], "format": "uuid" },
          "receivingUnitId": { "type": ["string", "null"], "format": "uuid" },
          "regionId": { "type": ["string", "null"], "format": "uuid" },
          "merchantId": { "type": ["string", "null"], "format": "uuid" },
          "ownerUserId": { "type": ["string", "null"], "format": "uuid", "description": "PIC CS; active member of this workspace, null = unassigned." },
          "transactionActivity": { "type": ["string", "null"] },
          "cause": { "type": ["string", "null"] },
          "foreignBranchReference": { "type": ["string", "null"] },
          "version": { "type": "integer", "minimum": 1, "description": "Optimistic lock; a stale version on mutation answers 409 version_conflict." },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Attachment": {
        "type": "object",
        "description": "Metadata only. No object key or download URL; download with ACL re-check is a later task.",
        "required": ["id", "ticketId", "fileName", "inspectedMime", "sizeBytes", "scanStatus", "visibility", "createdAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "ticketId": { "type": "string", "format": "uuid" },
          "fileName": { "type": "string" },
          "inspectedMime": { "type": ["string", "null"] },
          "sizeBytes": { "type": "integer", "minimum": 1 },
          "scanStatus": { "type": "string", "enum": ["pending", "clean", "infected", "scanner_unavailable", "rejected"] },
          "visibility": { "type": "string", "enum": ["public", "internal"] },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "ReportRun": {
        "type": "object",
        "description": "Operational report run metadata. Official BI export is held. The artifact reference is not exposed.",
        "required": ["id", "reportType", "periodStart", "periodEnd", "state", "generatedAt", "hasArtifact", "createdAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "reportType": { "type": "string", "enum": ["operational"] },
          "periodStart": { "type": "string", "format": "date" },
          "periodEnd": { "type": "string", "format": "date" },
          "state": { "type": "string", "enum": ["queued", "running", "succeeded", "failed"] },
          "generatedAt": { "type": ["string", "null"], "format": "date-time" },
          "hasArtifact": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "UatNotice": {
        "type": "object",
        "required": ["banner", "persistent", "dataScope", "superadminProvesRbac"],
        "properties": {
          "banner": { "type": "string", "examples": ["Mode uji — Superadmin"] },
          "persistent": { "type": "boolean", "const": true, "description": "The banner must stay visible on every screen and cannot be dismissed." },
          "dataScope": { "type": "string", "enum": ["dummy"] },
          "superadminProvesRbac": { "type": "boolean", "const": false, "description": "Superadmin sees everything; its access is not evidence for CS/Lead CS permissions." }
        }
      },
      "PermissionCode": {
        "type": "string",
        "enum": [
          "member.read",
          "catalog.read",
          "ticket.read",
          "ticket.create",
          "ticket.update",
          "ticket.transition",
          "ticket.resolve",
          "ticket.assign_self",
          "ticket.assign_any",
          "related_work.manage",
          "attachment.read",
          "attachment.upload",
          "report.view",
          "admin.members",
          "admin.settings",
          "integration.manage",
          "integration.credentials",
          "integration.recovery"
        ]
      },
      "GrantCode": { "type": "string", "enum": ["admin.members", "admin.settings", "integration.manage", "integration.credentials", "integration.recovery"] },
      "PermissionCatalog": {
        "type": "object",
        "required": ["permissions", "roles"],
        "properties": {
          "permissions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "label", "source"],
              "properties": {
                "code": { "$ref": "#/components/schemas/PermissionCode" },
                "label": { "type": "string" },
                "source": { "type": "string", "enum": ["role", "grant"], "description": "grant = only via an explicit workspace grant, never from a role" }
              }
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "label", "permissions"],
              "properties": {
                "code": { "type": "string", "enum": ["cs", "lead_cs"] },
                "label": { "type": "string" },
                "permissions": { "type": "array", "items": { "$ref": "#/components/schemas/PermissionCode" } }
              }
            }
          }
        }
      },
      "WorkspacePermissions": {
        "type": "object",
        "required": ["workspaceId", "role", "uatSuperadmin", "permissions", "grants"],
        "properties": {
          "workspaceId": { "type": "string", "format": "uuid" },
          "role": { "type": ["string", "null"], "enum": ["cs", "lead_cs", null], "description": "null for UAT Superadmin without membership" },
          "uatSuperadmin": { "type": "boolean" },
          "permissions": { "type": "array", "items": { "$ref": "#/components/schemas/PermissionCode" }, "description": "Effective for this request; UI hint only, the server re-checks every call." },
          "grants": { "type": "array", "items": { "$ref": "#/components/schemas/GrantCode" } }
        }
      },
      "Grant": {
        "type": "object",
        "required": ["id", "userId", "displayName", "membershipRole", "membershipActive", "grantCode", "grantedBy", "grantedAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "userId": { "type": "string", "format": "uuid" },
          "displayName": { "type": "string" },
          "membershipRole": { "type": "string", "enum": ["cs", "lead_cs"] },
          "membershipActive": { "type": "boolean" },
          "grantCode": { "$ref": "#/components/schemas/GrantCode" },
          "grantedBy": { "type": "string", "format": "uuid" },
          "grantedAt": { "type": "string", "format": "date-time" }
        }
      },
      "DashboardPeriodKey": {
        "type": "string",
        "enum": ["today", "last_7_days", "this_month"],
        "description": "Calendar periods in the workspace time zone. last_7_days = today minus 6 days through today; this_month = the whole calendar month."
      },
      "TicketFilter": {
        "type": "object",
        "description": "Drilldown parameters for the ticket list (D06, not built yet). Already scoped to the workspace in the path; absent keys mean no filter. Time bounds are half-open [from, before).",
        "properties": {
          "status": { "type": "array", "items": { "$ref": "#/components/schemas/TicketStatusCode" } },
          "owner": { "type": "string", "description": "Member user UUID, or the literal `unassigned`.", "examples": ["unassigned"] },
          "priority": { "type": "array", "items": { "type": "string" } },
          "receivedFrom": { "type": "string", "format": "date-time" },
          "receivedBefore": { "type": "string", "format": "date-time" },
          "resolvedFrom": { "type": "string", "format": "date-time" },
          "resolvedBefore": { "type": "string", "format": "date-time" }
        }
      },
      "TicketStatusCode": {
        "type": "string",
        "enum": ["new", "open", "pending_customer", "pending_engineering", "resolved", "closed"]
      },
      "DashboardPeriod": {
        "type": "object",
        "required": ["key", "basis", "timezone", "startDate", "endDate", "startAt", "endAt"],
        "properties": {
          "key": { "$ref": "#/components/schemas/DashboardPeriodKey" },
          "basis": { "type": "string", "enum": ["received"] },
          "timezone": { "type": "string", "examples": ["Asia/Jakarta"] },
          "startDate": { "type": "string", "format": "date", "description": "First local day (inclusive)." },
          "endDate": { "type": "string", "format": "date", "description": "Last local day (inclusive)." },
          "startAt": { "type": "string", "format": "date-time", "description": "Inclusive start instant (UTC)." },
          "endAt": { "type": "string", "format": "date-time", "description": "Exclusive end instant (UTC)." }
        }
      },
      "DashboardTotals": {
        "type": "object",
        "description": "Aggregated server-side over the whole workspace scope, never over a page.",
        "required": ["tickets", "active", "unassigned", "pendingCustomer", "receivedInPeriod", "resolvedInPeriod", "resolvedTicketsInPeriod"],
        "properties": {
          "tickets": { "type": "integer", "minimum": 0, "description": "All tickets in the workspace, any status (snapshot)." },
          "active": { "type": "integer", "minimum": 0, "description": "new + open + pending_customer + pending_engineering now (snapshot, not period-bound)." },
          "unassigned": { "type": "integer", "minimum": 0, "description": "Active tickets without a PIC now." },
          "pendingCustomer": { "type": "integer", "minimum": 0, "description": "Tickets in pending_customer now." },
          "receivedInPeriod": { "type": "integer", "minimum": 0, "description": "Tickets with received_at in [startAt, endAt)." },
          "resolvedInPeriod": { "type": "integer", "minimum": 0, "description": "Resolve events with occurred_at in the period; a later reopen does not remove them." },
          "resolvedTicketsInPeriod": { "type": "integer", "minimum": 0, "description": "Distinct tickets behind resolvedInPeriod." }
        }
      },
      "DashboardDrilldowns": {
        "type": "object",
        "required": ["active", "unassigned", "pendingCustomer", "receivedInPeriod", "resolvedInPeriod", "attention"],
        "properties": {
          "active": { "$ref": "#/components/schemas/TicketFilter" },
          "unassigned": { "$ref": "#/components/schemas/TicketFilter" },
          "pendingCustomer": { "$ref": "#/components/schemas/TicketFilter" },
          "receivedInPeriod": { "$ref": "#/components/schemas/TicketFilter" },
          "resolvedInPeriod": { "$ref": "#/components/schemas/TicketFilter" },
          "attention": { "$ref": "#/components/schemas/TicketFilter" }
        }
      },
      "DashboardStatusCount": {
        "type": "object",
        "required": ["status", "active", "count", "filter"],
        "properties": {
          "status": { "$ref": "#/components/schemas/TicketStatus" },
          "active": { "type": "boolean" },
          "count": { "type": "integer", "minimum": 0 },
          "filter": { "$ref": "#/components/schemas/TicketFilter" }
        }
      },
      "DashboardPicLoad": {
        "type": "object",
        "description": "One row per active member (0 included), per inactive member still holding active tickets, plus a final unassigned row (userId null).",
        "required": ["userId", "displayName", "memberActive", "activeTickets", "filter"],
        "properties": {
          "userId": { "type": ["string", "null"], "format": "uuid" },
          "displayName": { "type": ["string", "null"] },
          "memberActive": { "type": "boolean" },
          "activeTickets": { "type": "integer", "minimum": 0 },
          "filter": { "$ref": "#/components/schemas/TicketFilter" }
        }
      },
      "DashboardChannelCount": {
        "type": "object",
        "description": "Tickets received in the period per intake channel; null channel = not recorded.",
        "required": ["channelId", "code", "label", "count"],
        "properties": {
          "channelId": { "type": ["string", "null"], "format": "uuid" },
          "code": { "type": ["string", "null"] },
          "label": { "type": ["string", "null"] },
          "count": { "type": "integer", "minimum": 0 }
        }
      },
      "DashboardAgeBucket": {
        "type": "object",
        "description": "Active tickets by age since received_at. Not an SLA breach.",
        "required": ["key", "label", "count"],
        "properties": {
          "key": { "type": "string", "enum": ["lt_1d", "d1_2", "gt_2d"] },
          "label": { "type": "string" },
          "count": { "type": "integer", "minimum": 0 }
        }
      },
      "DashboardTrendPoint": {
        "type": "object",
        "required": ["date", "received", "resolved"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "received": { "type": "integer", "minimum": 0 },
          "resolved": { "type": "integer", "minimum": 0 }
        }
      },
      "DashboardNamed": {
        "type": "object",
        "required": ["id", "code", "label"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "code": { "type": ["string", "null"] },
          "label": { "type": "string" }
        }
      },
      "DashboardAttentionTicket": {
        "type": "object",
        "required": ["id", "number", "displayNumber", "subject", "status", "priority", "owner", "channel", "receivedAt", "ageSeconds"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "number": { "type": "integer", "minimum": 1 },
          "displayNumber": { "type": "string" },
          "subject": { "type": "string" },
          "status": { "$ref": "#/components/schemas/TicketStatus" },
          "priority": { "oneOf": [{ "$ref": "#/components/schemas/DashboardNamed" }, { "type": "null" }] },
          "owner": { "oneOf": [{ "$ref": "#/components/schemas/DashboardNamed" }, { "type": "null" }] },
          "channel": { "oneOf": [{ "$ref": "#/components/schemas/DashboardNamed" }, { "type": "null" }] },
          "receivedAt": { "type": "string", "format": "date-time" },
          "ageSeconds": { "type": "integer", "minimum": 0 }
        }
      },
      "DashboardAttention": {
        "type": "object",
        "description": "Active urgent/high tickets, urgent first then oldest received; at most `limit` items, `total` over the scope.",
        "required": ["total", "limit", "items"],
        "properties": {
          "total": { "type": "integer", "minimum": 0 },
          "limit": { "type": "integer", "minimum": 0 },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/DashboardAttentionTicket" } }
        }
      },
      "Dashboard": {
        "type": "object",
        "description": "Read-only snapshot from one REPEATABLE READ transaction. Synthetic dummy data in UAT.",
        "required": ["workspaceId", "workspaceCode", "asOf", "period", "slaConfigured", "totals", "drilldown", "statusDistribution", "picLoad", "channels", "age", "trend", "attention"],
        "properties": {
          "workspaceId": { "type": "string", "format": "uuid" },
          "workspaceCode": { "type": "string" },
          "asOf": { "type": "string", "format": "date-time" },
          "period": { "$ref": "#/components/schemas/DashboardPeriod" },
          "slaConfigured": { "type": "boolean" },
          "totals": { "$ref": "#/components/schemas/DashboardTotals" },
          "drilldown": { "$ref": "#/components/schemas/DashboardDrilldowns" },
          "statusDistribution": { "type": "array", "items": { "$ref": "#/components/schemas/DashboardStatusCount" } },
          "picLoad": { "type": "array", "items": { "$ref": "#/components/schemas/DashboardPicLoad" } },
          "channels": { "type": "array", "items": { "$ref": "#/components/schemas/DashboardChannelCount" } },
          "age": { "type": "array", "items": { "$ref": "#/components/schemas/DashboardAgeBucket" } },
          "trend": { "type": "array", "items": { "$ref": "#/components/schemas/DashboardTrendPoint" } },
          "attention": { "$ref": "#/components/schemas/DashboardAttention" }
        }
      }
    },
    "responses": {
      "VersionConflict": { "description": "Optimistic version is stale (version_conflict)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Unauthenticated": { "description": "No valid session", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "CsrfFailed": { "description": "CSRF check failed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "Not found or not accessible", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Forbidden": {
        "description": "Workspace is visible but the caller lacks the permission (default deny)",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "RuleViolation": { "description": "Refused by a domain rule; generic message, no SQL or scoped data", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "InvalidRequest": { "description": "A query parameter is not valid (invalid_request)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    }
  },
  "paths": {
    "/health/live": {
      "get": { "operationId": "healthLive", "responses": { "200": { "description": "Process is up" } } }
    },
    "/health/ready": {
      "get": {
        "operationId": "healthReady",
        "responses": {
          "200": { "description": "Database reachable and runtime guard holds" },
          "503": { "description": "Not ready" }
        }
      }
    },
    "/api/v1/meta": {
      "get": {
        "operationId": "getMeta",
        "responses": { "200": { "description": "Environment and banner", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Meta" } } } } }
      }
    },
    "/api/v1/uat/session": {
      "post": {
        "operationId": "enterUatSuperadmin",
        "description": "Direct UAT Superadmin entry. Only in UAT mode on a database marked as dummy test. Requires header `X-ITSM-UAT-Entry: 1`.",
        "parameters": [{ "name": "X-ITSM-UAT-Entry", "in": "header", "required": true, "schema": { "type": "string", "const": "1" } }],
        "responses": {
          "201": { "description": "Session issued; Set-Cookie HttpOnly SameSite=Strict", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SessionIssued" } } } },
          "403": { "$ref": "#/components/responses/CsrfFailed" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "413": { "description": "Body too large" },
          "503": { "description": "uat_not_available", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/v1/session": {
      "get": {
        "operationId": "getSession",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": { "description": "Current session", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Session" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      },
      "delete": {
        "operationId": "logout",
        "security": [{ "sessionCookie": [], "csrfHeader": [] }],
        "responses": {
          "204": { "description": "Session revoked; cookie cleared" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/CsrfFailed" }
        }
      }
    },
    "/api/v1/workspaces": {
      "get": {
        "operationId": "listWorkspaces",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": {
            "description": "Active workspaces the caller can access",
            "content": { "application/json": { "schema": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Workspace" } } } } } }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}": {
      "get": {
        "operationId": "getWorkspace",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/WorkspaceId" }],
        "responses": {
          "200": { "description": "Workspace", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Workspace" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}/members": {
      "get": {
        "operationId": "listWorkspaceMembers",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/WorkspaceId" }],
        "responses": {
          "200": {
            "description": "Members of an accessible workspace",
            "content": { "application/json": { "schema": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Member" } } } } } }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/ticket-statuses": {
      "get": {
        "operationId": "listTicketStatuses",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": {
            "description": "Ticket status codes with UI labels",
            "content": { "application/json": { "schema": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/TicketStatus" } } } } } }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    },
    "/api/v1/permissions": {
      "get": {
        "operationId": "getPermissionCatalog",
        "security": [{ "sessionCookie": [] }],
        "description": "Static permission catalog and role defaults for the UI.",
        "responses": {
          "200": { "description": "Catalog", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PermissionCatalog" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}/permissions": {
      "get": {
        "operationId": "getMyWorkspacePermissions",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/WorkspaceId" }],
        "responses": {
          "200": { "description": "Caller's effective permissions in this workspace", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkspacePermissions" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}/grants": {
      "get": {
        "operationId": "listWorkspaceGrants",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/WorkspaceId" }],
        "description": "Live grants. Requires admin.members; Lead CS without that grant gets 403.",
        "responses": {
          "200": {
            "description": "Live grants",
            "content": {
              "application/json": { "schema": { "type": "object", "required": ["items"], "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Grant" } } } } }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}/catalogs": {
      "get": {
        "operationId": "getWorkspaceCatalogs",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/WorkspaceId" }],
        "responses": {
          "200": { "description": "Catalogs of an accessible workspace (active and inactive)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Catalogs" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}/tickets/{ticket_id}": {
      "get": {
        "operationId": "getTicket",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/WorkspaceId" }, { "$ref": "#/components/parameters/TicketId" }],
        "responses": {
          "200": { "description": "Ticket", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ticket" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}/tickets/{ticket_id}/attachments/{attachment_id}": {
      "get": {
        "operationId": "getTicketAttachment",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/WorkspaceId" }, { "$ref": "#/components/parameters/TicketId" }, { "$ref": "#/components/parameters/AttachmentId" }],
        "responses": {
          "200": { "description": "Attachment metadata bound to this ticket", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Attachment" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}/report-runs/{report_run_id}": {
      "get": {
        "operationId": "getReportRun",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/WorkspaceId" }, { "$ref": "#/components/parameters/ReportRunId" }],
        "responses": {
          "200": { "description": "Operational report run metadata", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReportRun" } } } },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}/dashboard": {
      "get": {
        "operationId": "getDashboard",
        "summary": "Dashboard aggregates for one workspace (whole scope, not paginated)",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "name": "period", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/DashboardPeriodKey", "default": "today" } }
        ],
        "responses": {
          "200": { "description": "Dashboard", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Dashboard" } } } },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  }
}
