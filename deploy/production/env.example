# ITSM production stack (CP8). Copy to deploy/production/.env (git-ignored), fill in, then run
# deploy/production/check-config.sh before every `docker compose up`. Secrets never go here:
# they live in deploy/production/secrets/ (see deploy/RUNBOOK-production.md, section 1).

# Release image tag = git SHA that passed CI (images built with this tag).
ITSM_PROD_IMAGE_TAG=

# Ingress: hostname (no scheme/port), TLS mode and the network allowlist.
ITSM_PROD_SITE_ADDRESS=itsm.example.co.id
# internal (Caddy CA; clients must trust it) | file (company CA: tls/cert.pem + tls/key.pem)
# | an e-mail address for ACME (needs public DNS + port 80/443 reachable from the CA).
ITSM_PROD_TLS=file
# Office/VPN ranges, space or comma separated. 0.0.0.0/0 or ::/0 only with PUBLIC_ACCESS=on,
# which is an owner decision (internet exposure).
ITSM_PROD_ALLOWED_CIDRS=10.0.0.0/8
ITSM_PROD_PUBLIC_ACCESS=off
# Host addresses Caddy publishes on (bind to one interface if the host has several).
ITSM_PROD_HTTPS_BIND=0.0.0.0:443
ITSM_PROD_HTTP_BIND=0.0.0.0:80
# Internal network; change only if it collides with an existing route on the host.
ITSM_PROD_BACKEND_SUBNET=172.30.58.0/24
ITSM_PROD_INGRESS_IP=172.30.58.10

# Sign-in: password | sso | both (RUNBOOK-sso.md). MFA: off | on (needs secrets/mfa_recovery_pepper).
ITSM_AUTH=password
ITSM_MFA=off
# Active key id in secrets/itsm_keyring (empty only when the keyring file is empty).
ITSM_KEYRING_ACTIVE=

# Egress proxy upstream resolvers for Jira/Lark/IdP calls (RUNBOOK-egress.md).
ITSM_EGRESS_DNS=1.1.1.1 8.8.8.8

# Pool sizes (RUNBOOK-scaling.md): 2 x API + worker must stay <= 55 (itsm_app CONNECTION LIMIT 60;
# postgres max_connections 100).
ITSM_DB_MAX_CONNECTIONS=10
ITSM_WORKER_DB_MAX_CONNECTIONS=4
ITSM_DB_ACQUIRE_TIMEOUT_MS=3000

# Encrypted backups (RUNBOOK-production.md, section 5): base backup interval and how many to keep.
ITSM_BACKUP_INTERVAL_SECS=86400
ITSM_BACKUP_KEEP=7

# Optional limits (empty = application defaults, RUNBOOK-scaling.md).
ITSM_LIMIT_AUTH_PER_IP_10MIN=
ITSM_LIMIT_AI_PER_USER_MIN=
ITSM_LIMIT_AI_PER_WORKSPACE_DAY=
ITSM_LIMIT_OUTBOUND_PER_USER_10MIN=
ITSM_LIMIT_LOOKUP_PER_USER_MIN=
ITSM_LIMIT_WEBHOOK_PER_IP_MIN=
ITSM_INTEGRATIONS_TIMEOUT_MS=
