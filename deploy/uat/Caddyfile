# ITSM UAT ingress: single origin for web + API. Values come from ingress-guard.sh, which
# refuses to start Caddy unless the IP allowlist and basic auth are configured.
{
	admin off
	# Ports overridable only for local config tests; the container uses 80/443.
	http_port {$ITSM_UAT_HTTP_PORT:80}
	https_port {$ITSM_UAT_HTTPS_PORT:443}
	# With "tls internal" the operator distributes the Caddy root CA to UAT clients manually.
	skip_install_trust
	# Upstream API trusts X-Forwarded-For only from this proxy (ITSM_TRUSTED_PROXIES).
	# Client-supplied X-Forwarded-For is not trusted here (no trusted_proxies configured).
	log {
		output stdout
		format json
	}
}

{$ITSM_UAT_SITE_ADDRESS} {
	tls {$ITSM_UAT_TLS}
	# Access log. Caddy redacts Cookie, Set-Cookie and Authorization by default; the CSRF
	# token (a per-session secret) is removed here too.
	log {
		output stdout
		format filter {
			request>headers>X-Csrf-Token delete
			wrap json
		}
	}

	route {
		# 1) Network allowlist on the real TCP peer. Everything else: 403, nothing proxied.
		@outside not remote_ip {$ITSM_UAT_ALLOWED_CIDRS}
		respond @outside "Forbidden" 403 {
			close
		}

		# 2) Ingress login (bcrypt, standard HTTP basic auth over TLS).
		basic_auth {
			{$ITSM_UAT_BASIC_AUTH_USER} {$ITSM_UAT_BASIC_AUTH_HASH}
		}

		# CP7d (TM-07/TM-08): every response, web and API. The site address is the UAT host
		# itself, so includeSubDomains covers only names below it (no preload).
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "same-origin"
			X-Frame-Options "DENY"
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
			Cross-Origin-Opener-Policy "same-origin"
			-Server
		}

		# 3) Same origin: /api and /health go to the API, everything else is the SPA.
		@api path /api/* /health/*
		handle @api {
			reverse_proxy {$ITSM_UAT_API_UPSTREAM:api:8080} {
				header_up -Authorization
			}
		}
		handle {
			# CP7d (TM-07): the SPA loads only its own bundle (no inline script or style, no
			# third-party origin); checked in a browser by evidence/i3/cp7d/csp-check.mjs.
			header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
			root * {$ITSM_UAT_WEB_ROOT:/srv}
			try_files {path} /index.html
			file_server
		}
	}
}

# Container healthcheck only; bound to loopback inside the ingress container.
http://127.0.0.1:8099 {
	bind 127.0.0.1
	respond /ingress-health "ok" 200
}
